# 复制为 .env 后按需修改；所有键与 app/config/settings.py 的 env 前缀一一对应

# ---- LLM（必填：DashScope 兼容模式 API Key；留空则走本地降级向量/兜底话术）----
# 仅在此示例放占位符，真实密钥只写进本地 .env（已在 .gitignore 忽略，勿提交）
LLM__API_KEY=

# ---- 中间件（默认值已对齐 docker-compose，本机端口冲突时才需改）----
DB__URL=mysql+aiomysql://know_engine:know_engine@localhost:3307/know_engine?charset=utf8mb4
DB__FALLBACK_SQLITE=true
REDIS__URL=redis://localhost:6379/0
VECTOR__ES_URL=http://localhost:9200
NEO4J__URI=bolt://localhost:7687
NEO4J__PASSWORD=neo4j666
STORAGE__ENDPOINT=localhost:9000
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin

# ---- 应用 ----
APP__ENV=dev
APP__SECRET_KEY=please-change-me
QA_CACHE__ENABLED=false
QA_CACHE__TTL_DAYS=90
QA_CACHE__REVIEWER_IDS=TEST001
