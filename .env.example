# 复制为 .env 后按需修改；所有键与 app/config/settings.py 的 env 前缀一一对应

# ---- LLM（必填：DashScope 兼容模式 API Key；留空则走本地降级向量/兜底话术）----
# 仅在此示例放占位符，真实密钥只写进本地 .env（已在 .gitignore 忽略，勿提交）
LLM__API_KEY=

# ---- 本地模型容器化（叠加 docker-compose.local-models.yml 时生效）----
# 详见 docs/local-models-docker.md；不叠加该文件时以下变量无副作用
#
# 模式 A：业务 + 模型都在容器里 → 用 COMPOSE_PROFILES 打开模型服务
#   COMPOSE_PROFILES=models,rerank        # 语音再加 speech
#   MODEL_HOST=ollama                    # 默认值，可省略
#
# 模式 B：只起业务容器，模型跑在宿主机 → 不启用任何模型 profile
#   MODEL_HOST=host.docker.internal
#   RERANK_HOST=host.docker.internal
#   SPEECH_HOST=host.docker.internal
#
# 后端直接跑在宿主机（开发环境）时无需本文件：模型地址就是 http://localhost:11434 等。
# MODEL_HOST=ollama                    # 模式 A 默认
# RERANK_HOST=rerank                   # 模式 A 默认
# SPEECH_HOST=speech                   # 模式 A 默认
# LOCAL_LLM_BASE_URL=                  # 完整地址可覆盖主机名拼接
# LOCAL_RERANK_BASE_URL=
# LOCAL_SPEECH_BASE_URL=
# LOCAL_CHAT_MODEL=qwen2.5:7b
# LOCAL_FLASH_MODEL=qwen2.5:1.5b
# LOCAL_EMBEDDING_MODEL=bge-m3
# LOCAL_LLM_API_KEY=local
# RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf

# ---- 中间件（默认值已对齐 docker-compose，本机端口冲突时才需改）----
DB__URL=mysql+aiomysql://know_engine:know_engine@localhost:3307/know_engine?charset=utf8mb4
DB__FALLBACK_SQLITE=true
REDIS__URL=redis://localhost:6379/0
VECTOR__ES_URL=http://localhost:9200
NEO4J__URI=bolt://localhost:7687
NEO4J__PASSWORD=neo4j666
STORAGE__ENDPOINT=localhost:9000
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
# 分片上传会话目录（多实例必须共享同一目录；单机留空即 data/files/upload_sessions）
# STORAGE__UPLOAD_ROOT=

# ---- MCP 外部工具（联网搜索等；默认关闭）----
# 开启后：知识库检索为空、或问题涉及时效性（最新/今天/新闻…）时，
# 自动调用 MCP Server 的工具补充资料，结果注入回答（回答里保留来源链接）。
# MCP_SERVERS 为 JSON 数组，支持远程 HTTP 与本地 stdio 两种传输；
# Key 写在本文件的 TAVILY_API_KEY（或进程环境变量），配置中用 ${TAVILY_API_KEY} 引用；
# 启动时展开，解析顺序：本文件里配置的值优先，没有则回落到进程环境变量。
#   远程 HTTP（推荐，镜像内无需 Node）：
#     MCP_SERVERS=[{"name":"tavily","transport":"http","url":"https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}"}]
#   本地 stdio（需镜像内存在对应运行时，如 npx / uvx）：
#     MCP_SERVERS=[{"name":"search","transport":"stdio","command":"npx","args":["-y","tavily-mcp"],"env":{"TAVILY_API_KEY":"${TAVILY_API_KEY}"}}]
#
# 注意：本文件同时供 docker compose 与源码直跑使用，两种写法的键名不同——
#   docker compose：读 MCP_ENABLED / MCP_SERVERS，再注入为 MCP__ENABLED / MCP__SERVERS
#   本机源码直跑：应用直接读 MCP__ENABLED / MCP__SERVERS
# 直跑时把下面两行改名为 MCP__ENABLED / MCP__SERVERS 即可（其余配置同理：app/config/settings.py 的段名 + 双下划线）。
TAVILY_API_KEY=
MCP_ENABLED=false
MCP_SERVERS=[{"name":"tavily","transport":"http","url":"https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}"}]

# ---- 应用 ----
APP__ENV=dev
APP__SECRET_KEY=please-change-me
# 雪花 ID 工作节点号（0~1023）。多实例部署时每个实例必须不同，
# 留空/不配置则按 "主机名:端口" 自动派生（容器、Pod 主机名唯一时无需手动设置）。
# SNOWFLAKE__WORKER_ID=
# 定时补偿调度器开关。多实例部署时各实例均可开启，任务由 Redis 分布式锁抢占执行
# （因此多实例必须配置 REDIS__URL）；如需某实例不跑定时任务，设为 false。
SCHEDULER__ENABLED=true
# 文档处理事件队列：Redis 可用时写入 Stream（多实例共享消费组），
# 设为 false 则强制使用进程内分发（仅适合单机排障）。
EVENT__STREAM_ENABLED=true
QA_CACHE__ENABLED=false
QA_CACHE__TTL_DAYS=90
QA_CACHE__REVIEWER_IDS=TEST001

# ---- 统一日志（多实例共用一个 ES 日志索引；本地文件兜底留档）----
# 未配置 ES 或 ES 不可用时自动降级为仅本地文件，不阻塞业务请求。
LOGGING__LEVEL=INFO
LOGGING__FILE_ENABLED=true
# LOGGING__FILE_DIR=./logs
LOGGING__RETENTION_DAYS=30
LOGGING__ES_ENABLED=true
# LOGGING__ES_INDEX_PREFIX=know-engine-logs
# LOGGING__ES_QUEUE_SIZE=20000
